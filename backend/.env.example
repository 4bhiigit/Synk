# Django Settings
SECRET_KEY=django-insecure-chat-app-secret-key-change-in-prod-!89x#^90
DEBUG=True
ALLOWED_HOSTS=*

# Database (PostgreSQL URL for Neon / Supabase / Render, leave empty for local SQLite)
